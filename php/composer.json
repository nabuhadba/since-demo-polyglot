{
    "name": "fleetwise/invoices",
    "description": "Customer invoices: totals, PDF-ready markup, and the emails that go with them.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "firebase/php-jwt": "^5.5",
        "guzzlehttp/guzzle": "^7.4",
        "league/commonmark": "^2.3",
        "vlucas/phpdotenv": "^5.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "platform": {
            "php": "8.1.27"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

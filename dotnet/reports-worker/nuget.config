<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Fleetwise.* packages are published by the platform team. Credentials come from the machine's NuGet config. -->
    <add key="fleetwise-internal" value="https://nuget.fleetwise.internal/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="fleetwise-internal">
      <package pattern="Fleetwise.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
